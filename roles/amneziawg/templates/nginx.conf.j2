user www-data;
worker_processes auto;
pid /run/amneziawg-nginx.pid;
error_log /var/log/nginx/amneziawg-error.log;
events { worker_connections 512; }
http {
    access_log off;
    server_tokens off;
    client_body_temp_path /var/lib/nginx/amneziawg-body;
    proxy_temp_path /var/lib/nginx/amneziawg-proxy;
    server {
        listen 0.0.0.0:{{ amneziawg_nginx_port }}{% if amneziawg_tls_active %} ssl{% endif %};
        server_name _;
{% if amneziawg_tls_active %}
        ssl_certificate {{ amneziawg_directory }}/tls/cert.pem;
        ssl_certificate_key {{ amneziawg_directory }}/tls/key.pem;
        ssl_protocols TLSv1.2 TLSv1.3;
{% endif %}
        auth_basic "AmneziaWG admin";
        auth_basic_user_file /etc/amneziawg-nginx/htpasswd;
        location / {
            proxy_pass http://127.0.0.1:51821;
            proxy_http_version 1.1;
            proxy_set_header Host $http_host;
            proxy_set_header X-Real-IP $remote_addr;
            proxy_set_header X-Forwarded-For $remote_addr;
            proxy_set_header X-Forwarded-Proto $scheme;
            proxy_set_header Authorization "";
            proxy_set_header Connection "";
            proxy_cookie_flags ~ httponly samesite=lax{% if amneziawg_tls_active %} secure{% endif %};
        }
    }
}
